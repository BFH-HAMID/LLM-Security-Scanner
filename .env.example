# Copy to .env (or run `make env`, which fills in the secrets for you).
# Compose refuses to start until the two required secrets below are set.

# --- required secrets ------------------------------------------------------------------------
# Admin API key for the scanner API; the dashboard uses it too. Generate: openssl rand -hex 24
LLMSCAN_API_KEY=
# Password of the Postgres role "llmscan". Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- exposure --------------------------------------------------------------------------------
# Published ports are bound to this address. Keep 127.0.0.1 unless you have put the stack behind
# an authenticating reverse proxy. If you change it, ALSO set DASHBOARD_PASSWORD.
BIND_ADDR=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=3000
TARGET_PORT=9000

# HTTP Basic protection for the dashboard (user "admin" unless DASHBOARD_USER is set).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- scanning policy (see docs/SECURITY.md) ----------------------------------------------------
# Comma-separated fnmatch host patterns scans may target, e.g. *.staging.example.com. Empty = any.
LLMSCAN_TARGET_ALLOWLIST=
# Comma-separated environment variable NAMES that stored target configs may reference as ${NAME}.
# Empty = none (the safe default). Anything listed can be sent to whatever host a target points at.
LLMSCAN_ENV_ALLOWLIST=
LLMSCAN_MAX_CONCURRENCY=8
WORKER_CONCURRENCY=2

# --- optional: local model via the `ollama` profile ---------------------------------------------
#   docker compose --profile ollama up -d
OLLAMA_MODEL=llama3.2:3b
